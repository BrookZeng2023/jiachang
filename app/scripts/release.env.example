# Copy to app/release.local.env (gitignored) and fill in your values.

# Default: use the existing Xcode account (Settings -> Accounts).
RELEASE_AUTH=xcode

# Optional for RELEASE_AUTH=api. App Manager alone may not allow cloud signing;
# configure local distribution signing or verify the key's signing permissions.
# ASC_KEY_ID=ABC123DEFG
# ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Use the mounted, unlocked PrivateVault path, never the encrypted vault directory.
# ASC_KEY_PATH="/path/to/unlocked/PrivateVault/AuthKey_ABC123DEFG.p8"

# Apple Developer team that owns the app record.
DEVELOPMENT_TEAM=XXXXXXXXXX

# Optional: override the git commit count for retries or non-linear branch histories.
# Must exceed the build already uploaded for this version (1..9999).
# RELEASE_BUILD_NUMBER=2

# Optional: where archives and logs are written. Default: ~/Brook/Local/jiachang/releases
# RELEASE_OUTPUT_DIR=
